# Local development only. Never copy production secrets into this committed file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_SITE_URL=http://127.0.0.1:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production PostgreSQL variables are configured in Vercel. DATABASE_URL is supported.

# SMTP settings for sending email verification links
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=ProShop <no-reply@example.com>

# Razorpay test keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
